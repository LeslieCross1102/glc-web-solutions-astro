{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "glc-web-solutions",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// Workers Cache: cached pages are served without invoking the Worker (no CPU). Responses set their own policy in src/worker.ts
	"cache": {
		"enabled": true,
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "glc-emdash-db",
			"database_id": "dfe9fc69-1f8a-4bdb-b689-febb94d33cbe",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "glc-emdash-media",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// Scheduled publishing and maintenance; every 10 minutes keeps invocations (and CPU) down on the Free plan
	"triggers": {
		"crons": ["*/10 * * * *"],
	},
}
