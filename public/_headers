/glc/uploads/*
  Cache-Control: public, max-age=31536000, immutable

/glc/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/glc/build/site.*
  Cache-Control: public, max-age=31536000, immutable

/glc/assets/images/*
  Cache-Control: public, max-age=31536000

/glc/icons/*
  Cache-Control: public, max-age=31536000

/favicon.ico
  Cache-Control: public, max-age=31536000

/glc/rendered/*
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=3600

/glc/build/css/*
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=86400

/glc/assets/css/*
  Cache-Control: public, max-age=86400

/glc/assets/js/*
  Cache-Control: public, max-age=86400

/glc/wp/*
  Cache-Control: public, max-age=86400

/glc/:file
  Cache-Control: public, max-age=86400
