---
import { getEmDashEntry, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import RenderedBody from "../components/glc/RenderedBody.astro";
import { getRenderedPage } from "../rendered";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import { cachePublicPage } from "../utils/page-cache";

// WordPress front page (Settings → Reading) was imported as this page; its SEO drives the home <head>
const FRONT_PAGE_SLUG = "home-1";

const [settings, { entry: frontPage, cacheHint }] = await Promise.all([
	getSiteSettings(),
	getEmDashEntry("pages", FRONT_PAGE_SLUG),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);
const frontSeo = frontPage ? (frontPage.seo ?? frontPage.data.seo) : null;
const rendered = getRenderedPage("/");

if (Astro.cache?.enabled && cacheHint) Astro.cache.set(cacheHint);
cachePublicPage(Astro);
---

<Base
	title={frontSeo?.title || siteTitle}
	exactTitle={Boolean(frontSeo?.title)}
	description={frontSeo?.description || siteTagline}
	canonical={new URL("/", Astro.url.origin).href}
	bodyClass={rendered?.bodyClass}
	sections={rendered?.sections ?? true}
	renderedKey={rendered?.key}
>
	{rendered && <RenderedBody page={rendered} />}
</Base>
