---
import { getEmDashEntry, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import { getRenderedPage, loadRenderedHtml } from "../rendered";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import { cachePublicPage } from "../utils/page-cache";
import { shareImage } from "../data/glc/seo";
import { loadBlog } from "../utils/blog";
import { withLatestBlogCards } from "../utils/home-blog";

// WordPress front page (Settings → Reading) was imported as this page; its SEO drives the home <head>
const FRONT_PAGE_SLUG = "home-1";

const [settings, { entry: frontPage, cacheHint }, blog] = await Promise.all([
	getSiteSettings(),
	getEmDashEntry("pages", FRONT_PAGE_SLUG),
	loadBlog(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);
const frontSeo = frontPage ? (frontPage.seo ?? frontPage.data.seo) : null;
const rendered = getRenderedPage("/");
const homeHtml = rendered
	? withLatestBlogCards(await loadRenderedHtml(rendered, Astro.url), blog.posts)
	: "";

if (Astro.cache?.enabled) {
	if (cacheHint) Astro.cache.set(cacheHint);
	Astro.cache.set(blog.cacheHint);
}
cachePublicPage(Astro);
---

<Base
	title={frontSeo?.title || siteTitle}
	exactTitle={Boolean(frontSeo?.title)}
	description={frontSeo?.description || siteTagline}
	image={frontSeo?.image ? new URL(frontSeo.image, Astro.url.origin).href : shareImage("/", Astro.url.origin)}
	canonical={new URL("/", Astro.url.origin).href}
	bodyClass={rendered?.bodyClass}
	sections={rendered?.sections ?? true}
	renderedKey={rendered?.key}
>
	{homeHtml && <Fragment set:html={homeHtml} />}
</Base>
