---
import { decodeSlug, getSiteSettings } from "emdash";
import Base from "../../layouts/Base.astro";
import BlogIndex from "../../components/glc/blog/BlogIndex.astro";
import { canonicalUrl } from "../../rendered";
import { loadBlog, topicHeading } from "../../utils/blog";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";
import { cachePublicPage } from "../../utils/page-cache";

const slug = decodeSlug(Astro.params.slug);
const [blog, settings] = await Promise.all([loadBlog(), getSiteSettings()]);
const term = blog.posts.flatMap((post) => post.topics).find((topic) => topic.slug === slug);

if (!term) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(blog.cacheHint);
cachePublicPage(Astro);

const { siteTitle } = resolveBlogSiteIdentity(settings);
const headings = {
	topics: Object.fromEntries(
		[...blog.topics, term].map((topic) => [topic.slug, topicHeading(topic, siteTitle)]),
	),
};
const current = headings.topics[term.slug]!;
const posts = blog.posts.filter((post) => post.topics.some((topic) => topic.slug === term.slug));
---

<Base
	title={current.title}
	exactTitle
	pageTitle={current.heading}
	description={current.intro}
	canonical={canonicalUrl(Astro.url, `/category/${term.slug}/`)}
	image={posts[0]?.image && new URL(posts[0].image.src, Astro.url.origin).href}
	bodyClass={["glc-front", "glc-blog-index"]}
>
	<BlogIndex posts={posts} topics={blog.topics} headings={headings} active={term.slug} total={blog.posts.length} />
</Base>
