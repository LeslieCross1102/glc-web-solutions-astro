---
/** Props: { whatsappMessage: string } — static markup of glc_offer_form() (CF7 #4297) with the page's WhatsApp prefill; backend wired via data-glc-form="offer" */
import { offerFormId, phoneHref, whatsappUrl } from "../../../data/glc/trades/shared";

interface Props {
	whatsappMessage: string;
}

const { whatsappMessage } = Astro.props;
---

<div class="glc-offer-form-wrap" id="glc-offer-claim">
	<div class="wpcf7 no-js" id="wpcf7-f4297-o1" lang="en-GB" dir="ltr" data-wpcf7-id="4297">
		<div class="screen-reader-response"><p role="status" aria-live="polite" aria-atomic="true"></p> <ul></ul></div>
		<form method="post" class="wpcf7-form init" aria-label="Contact form" novalidate="novalidate" data-status="init" data-glc-form={offerFormId}>
			<div class="glc-offer-form">
				<p class="glc-offer-form__field"><label class="glc-visually-hidden" for="glc-offer-name">Name</label><span class="wpcf7-form-control-wrap" data-name="your-name"><input size="40" maxlength="400" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required" id="glc-offer-name" autocomplete="name" aria-required="true" aria-invalid="false" placeholder="Name" value="" type="text" name="your-name" /></span></p>
				<p class="glc-offer-form__field"><label class="glc-visually-hidden" for="glc-offer-email">Email</label><span class="wpcf7-form-control-wrap" data-name="your-email"><input size="40" maxlength="400" class="wpcf7-form-control wpcf7-email wpcf7-validates-as-required wpcf7-text wpcf7-validates-as-email" id="glc-offer-email" autocomplete="email" aria-required="true" aria-invalid="false" placeholder="Email" value="" type="email" name="your-email" /></span></p>
				<p class="glc-form-path"><span class="glc-form-path__legend">I need a</span><span class="wpcf7-form-control-wrap" data-name="your-path"><span class="wpcf7-form-control wpcf7-radio"><span class="wpcf7-list-item first"><label><input type="radio" name="your-path" value="New website" checked="checked" /><span class="wpcf7-list-item-label">New website</span></label></span><span class="wpcf7-list-item last"><label><input type="radio" name="your-path" value="Website redesign" /><span class="wpcf7-list-item-label">Website redesign</span></label></span></span></span></p>
				<p class="glc-form-path__url glc-offer-form__field" data-glc-form-url><label class="glc-visually-hidden" for="glc-offer-website">Current website address</label><span class="wpcf7-form-control-wrap" data-name="your-website"><input size="40" maxlength="400" class="wpcf7-form-control wpcf7-url wpcf7-text wpcf7-validates-as-url" id="glc-offer-website" autocomplete="url" aria-invalid="false" placeholder="Current website address" value="" type="url" name="your-website" /></span></p>
				<p class="glc-offer-form__field"><label class="glc-visually-hidden" for="glc-offer-brief">Brief description</label><span class="wpcf7-form-control-wrap" data-name="your-brief"><textarea cols="40" rows="4" maxlength="2000" class="wpcf7-form-control wpcf7-textarea wpcf7-validates-as-required" id="glc-offer-brief" aria-required="true" aria-invalid="false" placeholder="Brief description" name="your-brief"></textarea></span></p>
				<p class="glc-offer-form__consent"><span class="wpcf7-form-control-wrap" data-name="acceptance-contact"><span class="wpcf7-form-control wpcf7-acceptance"><span class="wpcf7-list-item"><label><input type="checkbox" name="acceptance-contact" value="1" aria-invalid="false" /><span class="wpcf7-list-item-label">I consent to GLC Web Solutions contacting me about this enquiry using the details I have provided.</span></label></span></span></span></p>
				<p class="glc-offer-form__submit"><input class="wpcf7-form-control wpcf7-submit has-spinner glc-button glc-button--primary" type="submit" value="Submit" /></p>
			</div>
			<div class="glc-form-thanks" data-glc-form-thanks>
				<figure class="glc-form-thanks__figure">
					<img
						class="glc-form-thanks__image"
						src="/glc/assets/images/glc-form-thanks.png"
						alt=""
						width="516"
						height="554"
						decoding="async"
					/>
				</figure>
				<div class="glc-form-thanks__copy">
					<p class="glc-form-thanks__eyebrow">Message sent</p>
					<p class="glc-form-thanks__title">We&#039;ll get back to you as soon as we can.</p>
					<p class="glc-form-thanks__text">Thanks for getting in touch — your enquiry is on its way to Gareth.</p>
					<div class="glc-form-thanks__actions">
						<button type="button" class="glc-button glc-button--primary" data-glc-form-reset>
							Submit another query
						</button>
						<a class="glc-button glc-button--whatsapp" href={whatsappUrl(whatsappMessage)} target="_blank" rel="noopener noreferrer">
							<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" /></svg>
							WhatsApp
						</a>
						<a class="glc-button glc-button--secondary" href={phoneHref}>
							Call now
						</a>
					</div>
				</div>
			</div>
			<p class="glc-recaptcha-notice">This site is protected by reCAPTCHA and the Google <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Privacy Policy</a> and <a href="https://policies.google.com/terms" target="_blank" rel="noopener noreferrer">Terms of Service</a> apply.</p>
			<div class="wpcf7-response-output" aria-hidden="true"></div>
		</form>
	</div>
</div>
