---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import {
	WidgetArea,
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import GlcHead from "../components/glc/GlcHead.astro";
import GlcHeader from "../components/glc/GlcHeader.astro";
import GlcFooter from "../components/glc/GlcFooter.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import assets from "../generated/assets.json";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	title: string;
	/** Use `title` verbatim (e.g. an imported SEO title) instead of appending the site name */
	exactTitle?: boolean;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	/** Extra body classes the GLC CSS keys off (e.g. glc-front, glc-about) */
	bodyClass?: string[];
	/** Load home.css for section-based layouts */
	sections?: boolean;
	trade?: "electricians" | "pubs" | "landscapers";
	/** Rendered page key, for its purged stylesheet */
	renderedKey?: string | null;
}

const {
	title,
	exactTitle = false,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
	bodyClass = [],
	sections = true,
	trade,
	renderedKey,
} = Astro.props;

const glcTheme = {
	schemeToggle: false,
	storageKey: "glc-color-scheme",
	offerBannerKey: "glc-offer-banner",
	openMenuLabel: "Open menu",
	closeMenuLabel: "Close menu",
	contactUrl: "/contacts/",
	contactFormId: 0,
};
const { env: workerEnv } = (await import("cloudflare:workers")) as unknown as {
	env: { TURNSTILE_SITE_KEY?: string };
};
const glcForms = { endpoint: "/api/enquiry", turnstileSiteKey: workerEnv.TURNSTILE_SITE_KEY ?? "" };
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveBlogSiteIdentity(
	settingsResult.data,
);
const titleIncludesSiteName =
	exactTitle ||
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} | ${siteTitle}`;

const menu = menuResult.data;

// Build public page context for plugin contributions
// SEO data is passed here and rendered securely by EmDashHead
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

// Check if user is logged in (for showing admin link)
const isLoggedIn = !!Astro.locals.user;
---

<!doctype html>
<html lang="en-GB" class="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<GlcHead renderedKey={renderedKey} sections={sections} trade={trade} />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
	</head>
	<body class={["glc-theme", "glc-has-custom-chrome", ...bodyClass].join(" ")}>
		<EmDashBodyStart page={pageCtx} />
		<a class="skip-link screen-reader-text" href="#content">Skip to content</a>
		<div id="page" class="hfeed site">
			<GlcHeader />
			<div id="content" class="site-content">
				<slot />
			</div>
			<GlcFooter />
		</div>
		{
			isLoggedIn && (
				<a href="/_emdash/admin" class="glc-admin-link">
					Admin
				</a>
			)
		}
		<script is:inline define:vars={{ glcTheme, glcForms }}>
			window.glcTheme = glcTheme;
			window.glcForms = glcForms;
		</script>
		<script is:inline src={assets.script} defer></script>
		<EmDashBodyEnd page={pageCtx} />
		<style is:global>
			.glc-admin-link {
				position: fixed;
				right: 1rem;
				bottom: 1rem;
				z-index: 1000;
				padding: 0.4rem 0.8rem;
				border-radius: 999px;
				background: #0f172a;
				color: #fff;
				font: 600 0.8rem/1 system-ui, sans-serif;
				text-decoration: none;
			}
		</style>
	</body>
</html>
